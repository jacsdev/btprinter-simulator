# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local agent tooling (machine-specific, contains absolute home paths)
.atl/

# Captured ESC/POS byte dumps produced by --dump-bytes.
# These are raw print jobs and may contain personal data such as passenger
# names and document numbers. Never commit a capture taken from real data.
# A sanitised fixture may be added deliberately with `git add -f`.
*.bin
# ...except vetted regression fixtures under tests/fixtures/, which contain
# no personal data and are meant to be tracked (see tests/fixtures/ping-pong.bin).
!tests/fixtures/*.bin

# Rendered output
*.png
# ...except documentation screenshots, which belong in the repo
!docs/*.png

# Local agent instructions (not part of the project)
CLAUDE.md

# Windows/Git Bash artifact: `> nul` in a POSIX shell creates a literal file
# named "nul" instead of writing to the Windows null device.
nul
